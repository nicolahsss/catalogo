<?xml version="1.0"?>
<ruleset name="Catalogo PHP CodeSniffer Ruleset">
  <description>PHP CodeSniffer ruleset for Catalogo</description>
  <config name="testVersion" value="8.2"/>
  <rule ref="PSR12"/>
